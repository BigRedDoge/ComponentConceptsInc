# Terraform working directory — do NOT ignore .terraform.lock.hcl;
# it pins provider versions and must be committed for reproducible CI runs.
.terraform/

# State files — never commit state; it contains account IDs and ARNs.
# bootstrap/ uses local state intentionally but should not be committed either.
*.tfstate
*.tfstate.backup

# Variable overrides may contain sensitive values
terraform.tfvars

# Plan output files
*.tfplan
